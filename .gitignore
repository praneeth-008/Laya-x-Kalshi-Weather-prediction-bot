# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Secrets and API credentials
.env
*.env

# Jupyter
.ipynb_checkpoints/

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Data - never commit downloaded datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Exception: weather pilot state, for laptop -> desktop migration via GitHub.
# Everything else under data/raw/* and data/processed/* stays ignored (Kalshi
# bulk data, one-day GRIB2 feasibility-test messages, un-started pilot
# sources, etc.) -- these are the only paths explicitly allowed through.
!data/raw/pilot/
data/raw/pilot/*
!data/raw/pilot/observations/
!data/raw/pilot/afd/

!data/processed/pilot/
data/processed/pilot/*
!data/processed/pilot/observations/
!data/processed/pilot/afd/
!data/processed/pilot/hrrr/
# Bulk HRRR Parquet output stays out of Git regardless of source machine --
# only the checkpoint/report metadata directly under hrrr/ is lightweight
# enough to track; the actual extracted rows (parts/) are not.
data/processed/pilot/hrrr/parts/*

# GFS and the HRRR APCP_1H backfill: only the reproducibility manifest
# (manifest.json, see docs/reproducibility.md) is tracked -- checkpoint,
# download report, and all Parquet output stay untracked/local, same
# policy as the bulk HRRR parts above.
!data/processed/pilot/gfs/
data/processed/pilot/gfs/*
!data/processed/pilot/gfs/manifest.json

!data/processed/pilot/hrrr_apcp_1h/
data/processed/pilot/hrrr_apcp_1h/*
!data/processed/pilot/hrrr_apcp_1h/manifest.json

# NBM: same policy as GFS -- only the reproducibility manifest is tracked.
!data/processed/pilot/nbm/
data/processed/pilot/nbm/*
!data/processed/pilot/nbm/manifest.json

# GEFS: same policy as GFS/NBM -- only the reproducibility manifest is
# tracked. Own dedicated directory, never shared with validation/benchmark
# scratch output (see docs/gefs_pilot_readiness.md's contamination check).
!data/processed/pilot/gefs/
data/processed/pilot/gefs/*
!data/processed/pilot/gefs/manifest.json

!data/processed/weather/
data/processed/weather/*
!data/processed/weather/pilot/
data/processed/weather/pilot/*
!data/processed/weather/pilot/selected_days.csv

# Model checkpoints
*.pt
*.pth
*.bin
*.safetensors

# Logs
*.log
