# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Secrets and API credentials
.env
*.env
*.pem
private_key.pem

# Jupyter
.ipynb_checkpoints/

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Data - never commit downloaded datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Exception: weather pilot state, for laptop -> desktop migration via GitHub.
# Everything else under data/raw/* and data/processed/* stays ignored (Kalshi
# bulk data, one-day GRIB2 feasibility-test messages, un-started pilot
# sources, etc.) -- these are the only paths explicitly allowed through.
!data/raw/pilot/
data/raw/pilot/*
!data/raw/pilot/observations/
!data/raw/pilot/afd/

!data/processed/pilot/
data/processed/pilot/*
!data/processed/pilot/observations/
!data/processed/pilot/afd/
!data/processed/pilot/hrrr/
# Bulk HRRR Parquet output stays out of Git regardless of source machine --
# only the checkpoint/report metadata directly under hrrr/ is lightweight
# enough to track; the actual extracted rows (parts/) are not.
data/processed/pilot/hrrr/parts/*

# GFS and the HRRR APCP_1H backfill: only the reproducibility manifest
# (manifest.json, see docs/reproducibility.md) is tracked -- checkpoint,
# download report, and all Parquet output stay untracked/local, same
# policy as the bulk HRRR parts above.
!data/processed/pilot/gfs/
data/processed/pilot/gfs/*
!data/processed/pilot/gfs/manifest.json

!data/processed/pilot/hrrr_apcp_1h/
data/processed/pilot/hrrr_apcp_1h/*
!data/processed/pilot/hrrr_apcp_1h/manifest.json

# HRRR RH backfill (2026-09-29 pipeline-survival fix): same additive-backfill
# policy as hrrr_apcp_1h -- only the reproducibility manifest is tracked.
!data/processed/pilot/hrrr_rh/
data/processed/pilot/hrrr_rh/*
!data/processed/pilot/hrrr_rh/manifest.json

# NBM: same policy as GFS -- only the reproducibility manifest is tracked.
!data/processed/pilot/nbm/
data/processed/pilot/nbm/*
!data/processed/pilot/nbm/manifest.json

# GEFS: same policy as GFS/NBM -- only the reproducibility manifest is
# tracked. Own dedicated directory, never shared with validation/benchmark
# scratch output (see docs/gefs_pilot_readiness.md's contamination check).
!data/processed/pilot/gefs/
data/processed/pilot/gefs/*
!data/processed/pilot/gefs/manifest.json

# ECMWF: same policy as GFS/NBM/GEFS -- only the reproducibility manifest
# is tracked. Own dedicated directory, never shared with validation/
# benchmark scratch output.
!data/processed/pilot/ecmwf/
data/processed/pilot/ecmwf/*
!data/processed/pilot/ecmwf/manifest.json

# Integrated 40-day point-in-time dataset: only the manifest is tracked.
# The dataset itself (state_index/structured_features/trajectories/
# gefs_members/human_readable_states/audit_report) is fully reproducible
# from frozen source outputs + scripts/build_integrated_pilot.py + this
# manifest's recorded commit -- see docs/integrated_pilot_validation.md.
!data/processed/pilot/integrated/
data/processed/pilot/integrated/*
!data/processed/pilot/integrated/manifest.json
!data/processed/pilot/integrated/variable_inventory.json

!data/processed/weather/
data/processed/weather/*
!data/processed/weather/pilot/
data/processed/weather/pilot/*
!data/processed/weather/pilot/selected_days.csv

# HISTORICAL BACKFILL (2026-09-29 onward, 10 six-month blocks, scripts/backfill_*.py):
# only each block's own manifest/audit-report is tracked -- same bulk-data
# policy as every pilot source above. All raw/processed/integrated Parquet,
# logs, and checkpoints stay local-only; the manifest is enough to
# reconstruct everything deterministically from frozen sources + code.
!data/processed/backfill/
data/processed/backfill/*
!data/processed/backfill/*/
data/processed/backfill/*/*
!data/processed/backfill/*/block_manifest.json
!data/processed/backfill/*/integrated/
data/processed/backfill/*/integrated/*
!data/processed/backfill/*/integrated/audit_report.json

# CLINYC canonical label layer (2026-10-04, see docs/decisions.md): only the
# validation/harmonization JSON reports are tracked, same policy as every
# other source's manifest above. Raw cached report text and the per-day
# labels Parquet stay local-only (fully reproducible from data/clinyc.py +
# scripts/backfill_clinyc.py + the IEM archive).
!data/processed/backfill/*/clinyc/
data/processed/backfill/*/clinyc/*
!data/processed/backfill/*/clinyc/clinyc_validation_report.json
!data/processed/backfill/*/clinyc/harmonization_summary.json

# Raw backfill observations/AFD text (per-year/per-product, not bulk GRIB --
# but still not tracked; reproducible from the extraction scripts).
data/raw/backfill/

# Live KXHIGHNY L2 recorder output (2026-10-04, scripts/kxhighny_recorder.py):
# raw L2/trade capture and per-day manifests are never committed -- only the
# recorder CODE, its tests, and docs are. This is intentionally a stricter
# policy than the historical backfill's manifest-tracking above.
data/live_kalshi_weather/

# Model checkpoints
*.pt
*.pth
*.bin
*.safetensors

# Logs
*.log
